      "pins": "§6.3.2 row 1",
      "local": {
        "settings": {
          "general": {
            "accentColor": "x"
          }
        },
        "fieldClocks": {
          "general.accentColor": {
            "device-a": 2,
            "device-b": 1
          }
        }
      },
      "remote": {
        "settings": {
          "general": {
            "accentColor": "y"
          }
        },
        "fieldClocks": {
          "general.accentColor": {
            "device-c": 5
          }
        }
      },
      "expected": {
        "settings": {
          "general": {
            "accentColor": "y"
          }
        },
        "fieldClocks": {
          "general.accentColor": {
            "device-a": 2,
            "device-b": 1,
            "device-c": 5
          }
        },
        "requeue": true
      }
