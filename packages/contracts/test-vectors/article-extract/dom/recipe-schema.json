  "document": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Lemon Olive Oil Cake</title>\n<meta property=\"og:image\" content=\"/images/cake.jpg\">\n<script type=\"application/ld+json\">\n[{\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"name\":\"Lemon Olive Oil Cake\",\"author\":{\"@type\":\"Person\",\"name\":\"Rosa Bellini\"},\"datePublished\":\"2023-11-02\",\"description\":\"A moist, fragrant cake that keeps for days.\",\"recipeYield\":\"8 servings\",\"prepTime\":\"PT15M\",\"cookTime\":\"PT45M\",\"recipeIngredient\":[\"3 eggs\",\"200 g sugar\",\"120 ml olive oil\",\"zest of 2 lemons\",\"220 g flour\"],\"recipeInstructions\":[{\"@type\":\"HowToStep\",\"text\":\"Whisk eggs and sugar until pale.\"},{\"@type\":\"HowToStep\",\"text\":\"Fold in oil, zest and flour.\"},{\"@type\":\"HowToStep\",\"text\":\"Bake at 170C for 45 minutes.\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[]}]\n</script></head><body>\n<div class=\"recipe-card\" itemscope itemtype=\"http://schema.org/Recipe\">\n<h1 itemprop=\"name\">Lemon Olive Oil Cake</h1>\n<p class=\"recipe-meta\">By <span itemprop=\"author\">Rosa Bellini</span> · Prep <time itemprop=\"prepTime\" datetime=\"PT15M\">15 min</time> · Bake <time itemprop=\"cookTime\" datetime=\"PT45M\">45 min</time></p>\n<img itemprop=\"image\" src=\"/images/cake.jpg\" alt=\"Sliced lemon cake\">\n<h2>Ingredients</h2>\n<ul class=\"ingredients\"><li itemprop=\"recipeIngredient\">3 eggs</li><li itemprop=\"recipeIngredient\">200 g sugar</li><li itemprop=\"recipeIngredient\">120 ml olive oil</li><li itemprop=\"recipeIngredient\">zest of 2 lemons</li><li itemprop=\"recipeIngredient\">220 g flour</li></ul>\n<h2>Method</h2>\n<ol class=\"instructions\"><li itemprop=\"recipeInstructions\">Whisk eggs and sugar until pale.</li><li itemprop=\"recipeInstructions\">Fold in oil, zest and flour.</li><li itemprop=\"recipeInstructions\">Bake at 170°C for 45 minutes.</li></ol>\n<p class=\"tip\">Tip: the cake tastes better the next day.</p>\n</div>\n<div class=\"print-recipe\"><a href=\"#\" onclick=\"window.print();return false\">Print</a></div>\n</body></html>\n",
