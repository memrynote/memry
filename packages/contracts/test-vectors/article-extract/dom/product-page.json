  "headBody": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Steel Bottle 750 ml - Example Shop</title>\n<meta property=\"og:type\" content=\"product\"><meta property=\"og:image\" content=\"https://shop.example.com/img/bottle.jpg\">\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Steel Bottle 750 ml\",\"description\":\"Double-walled, keeps drinks cold for 24 hours.\",\"offers\":{\"@type\":\"Offer\",\"price\":\"24.00\",\"priceCurrency\":\"EUR\"}}</script></head><body>\n<div class=\"product\"><h1 class=\"product-title\">Steel Bottle 750 ml</h1><div class=\"price\">€24.00</div>\n<form class=\"add-to-cart\" action=\"/cart\" method=\"post\"><label>Colour <select name=\"colour\"><option value=\"black\" selected>Black</option><option value=\"sand\">Sand</option></select></label><input type=\"number\" name=\"qty\" value=\"1\" min=\"1\"><button type=\"submit\" class=\"btn-buy\">Add to cart</button></form>\n<div class=\"description\"><p>Double-walled stainless steel keeps drinks cold for 24 hours and hot for 12. Fits most cup holders. Dishwasher safe except the lid.</p><ul><li>750 ml</li><li>BPA free</li><li>Two-year warranty</li></ul></div>\n<div class=\"reviews\"><h2>Reviews</h2><div class=\"review\"><span class=\"stars\">5/5</span><p>Keeps ice for a day.</p></div></div></div>\n<div class=\"recommended\"><h3>You may also like</h3></div></body></html>\n"
}
