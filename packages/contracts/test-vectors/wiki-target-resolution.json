      "expected": "istanbul"
    },
    {
      "name": "turkish-dotless-i",
      "pins": "ı stays ı",
      "input": "ışık",
      "expected": "ışık"
    },
    {
      "name": "sharp-s",
      "pins": "ß stays ß, no full case folding to ss",
      "input": "Straße",
      "expected": "straße"
    },
    {
      "name": "final-sigma",
      "pins": "final sigma folds to σ in any position",
      "input": "ΟΔΟΣ",
      "expected": "οδοσ"
    },
    {
      "name": "nfc",
      "pins": "NFD input composes before folding",
      "input": "Café",
      "expected": "café"
    },
    {
      "name": "whitespace",
      "pins": "tabs, NBSP and runs collapse to one space; ends trimmed",
      "input": " \tQ3   plan\n",
      "expected": "q3 plan"
    },
    {
      "name": "bom-kept",
      "pins": "U+FEFF is not White_Space, so it stays",
      "input": "﻿Plan",
      "expected": "﻿plan"
    },
    {
      "name": "empty",
      "pins": "whitespace only is no name",
      "input": " \t ",
      "expected": null
    }
