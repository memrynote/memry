        },
        {
          "start": 34,
          "end": 38,
          "text": "plan"
        }
      ],
      "linked": "éhttps://plan.example and 1http://[[Plan|plan]]"
    },
    {
      "name": "unclosed",
      "pins": "an unclosed link or comment is text",
