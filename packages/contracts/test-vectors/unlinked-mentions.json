      "names": [
        "Plan"
      ],
      "title": "Plan",
      "ordinal": 2,
      "expected": [
        {
          "start": 2,
          "end": 6,
          "text": "Plan"
        },
        {
          "start": 12,
          "end": 16,
          "text": "Plan"
        },
        {
          "start": 20,
          "end": 24,
          "text": "plan"
        },
        {
          "start": 30,
          "end": 34,
          "text": "plan"
        }
      ],
      "linked": "[[Plan and [Plan](x [[Plan|plan]] <!-- plan"
    },
    {
      "name": "offsets-after-masked-non-ascii",
      "pins": "offsets index the markdown after blanked astral and accented text",
      "markdown": "`😀é` [[ü]] Plan",
      "names": [
        "Plan"
      ],
      "title": "Plan",
      "ordinal": 0,
      "expected": [
        {
          "start": 12,
          "end": 16,
          "text": "Plan"
        }
      ],
      "linked": "`😀é` [[ü]] [[Plan]]"
    },
    {
      "name": "alias-link",
      "pins": "a mention spelled otherwise links as [[Title|text]]",
      "markdown": "The roadmap and the Roadmap.",
      "names": [
        "Q3 Plan",
        "Roadmap"
      ],
      "title": "Q3 Plan",
      "ordinal": 1,
      "expected": [
        {
          "start": 4,
          "end": 11,
          "text": "roadmap"
        },
        {
          "start": 20,
          "end": 27,
          "text": "Roadmap"
        }
      ],
      "linked": "The roadmap and the [[Q3 Plan|Roadmap]]."
    },
    {
      "name": "ordinal-out-of-range",
      "pins": "a mention that is gone links nothing",
      "markdown": "Plan once.",
      "names": [
        "Plan"
      ],
      "title": "Plan",
      "ordinal": 1,
      "expected": [
        {
          "start": 0,
