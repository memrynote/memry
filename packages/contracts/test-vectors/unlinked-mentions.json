      "expected": [
        {
          "start": 72,
          "end": 76,
          "text": "Plan"
        }
      ],
      "linked": "[[Plan]] [[Other|Plan]] ![[Plan.png]] [Plan](Plan.md) ![Plan](plan.png) [[Plan]]"
    },
    {
      "name": "urls",
