      "names": [
        "Plan"
      ],
      "title": "Plan",
      "ordinal": 1,
      "expected": [
        {
          "start": 0,
          "end": 4,
          "text": "Plan"
        },
        {
          "start": 33,
          "end": 37,
          "text": "plan"
        }
      ],
      "linked": "Plan `Plan` here.\n\n```\nPlan\n```\n\n[[Plan|plan]] again"
    },
    {
      "name": "comments",
      "pins": "HTML and Obsidian comments are not scanned",
