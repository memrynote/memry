  <note>
    <title>Sample &amp; Evernote &#233; Note</title>
    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note style="x">
  <div>Hello from <b>Evernote</b>!</div>
  <div><en-todo checked="true"/>Finished <b>task</b></div>
  <div><en-todo checked="false"/>Pending task<br/>after break</div>
  <en-todo checked="TRUE"/>Upper case is unchecked</p>
