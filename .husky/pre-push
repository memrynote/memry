#!/usr/bin/env sh
set -eu

# git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin.
# Read it once, before the checks below, and refuse any update that would drop remote
# commits: a force push, with or without --force-with-lease.
push_refs=$(cat)

is_zero_sha() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

refuse_push() {
  printf '\npre-push: refusing to push %s: %s\n' "$1" "$2" >&2
  printf 'pre-push: never force push. Merge the base into your branch instead of rebasing a pushed branch.\n\n' >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  # A deletion or a new remote ref overwrites no commits.
  if is_zero_sha "$local_sha" || is_zero_sha "$remote_sha"; then
    continue
  fi
  if ! git cat-file -e "$remote_sha" 2>/dev/null; then
    refuse_push "$remote_ref" "the remote is at $remote_sha, which this clone does not have; fetch first"
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    refuse_push "$remote_ref" "$local_sha does not contain the remote's $remote_sha, so the push would overwrite it"
  fi
done <<EOF
$push_refs
EOF

current_branch=$(git branch --show-current)

case "$current_branch" in
  codex/*|codex-*|t3code*|t3code/*|claude/*|claude-*|cursor/*|cursor-*|fox-inline-go)
    printf '\npre-push: rename tool-branded/random branch before pushing: %s\n\n' "$current_branch" >&2
    exit 1
    ;;
esac

# Diff the whole branch against origin/main, as CI's docs gate does. Using @{u} would
# only cover commits since the last push and flag a comment-only follow-up push on a
# branch that already updated docs.
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  base_commit=$(git merge-base HEAD origin/main)
else
  base_commit=$(git rev-list --max-parents=0 HEAD | tail -n 1)
fi

changed_files=$(git diff --name-only --diff-filter=ACMR "$base_commit"...HEAD)

if [ -z "$changed_files" ]; then
  exit 0
fi

has_changes() {
  printf '%s\n' "$changed_files" | grep -E "$1" >/dev/null
}

code_changed='^(apps/desktop|apps/desktop-tauri|crates|apps/sync-server|packages|scripts|package.json|pnpm-lock.yaml|pnpm-workspace.yaml|oxlint.config.mts|scripts/lint-baseline.json|lint-staged.config.mjs|tsconfig|turbo.json)'

if ! has_changes "$code_changed"; then
  exit 0
fi

# MEMRY_DOCS_IMPACT_SKIP=1 is honoured inside scripts/docs-impact.mjs, so the manual
# `pnpm docs:impact --strict` run and this hook share one escape hatch.
set +e
pnpm docs:impact --base "$base_commit" --strict
docs_impact_status=$?
set -e

if [ "$docs_impact_status" -ne 0 ]; then
  if [ "$docs_impact_status" -ne 1 ]; then
    exit "$docs_impact_status"
  fi

  if ! git diff --quiet -- apps/docs/src ||
    ! git diff --cached --quiet -- apps/docs/src; then
    printf '\npre-push: uncommitted docs changes exist. Commit them before pushing.\n\n' >&2
    exit 1
  fi

  if [ "${MEMRY_DOCS_AI_AUTO:-0}" = "1" ]; then
    printf '\npre-push: running AI docs updater for desktop/sync-server changes...\n\n' >&2
    pnpm docs:ai-update --base "$base_commit"

    if ! git diff --quiet -- apps/docs/src; then
      printf '\npre-push: AI updated docs. Review, verify, commit, and push again.\n\n' >&2
    else
      printf '\npre-push: AI did not change docs. If no docs are needed, retry with MEMRY_DOCS_IMPACT_SKIP=1.\n\n' >&2
    fi
  else
    printf '\npre-push: docs update required. Run `pnpm docs:ai-update --base %s` or update apps/docs/src manually.\n' "$base_commit" >&2
    printf 'pre-push: set MEMRY_DOCS_AI_AUTO=1 to let this hook run the updater.\n' >&2
    printf 'pre-push: if this change genuinely needs no docs, retry with MEMRY_DOCS_IMPACT_SKIP=1.\n\n' >&2
  fi

  exit 1
fi
