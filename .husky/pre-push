#!/usr/bin/env sh
set -eu

current_branch=$(git branch --show-current)

case "$current_branch" in
  codex/*|codex-*|t3code*|t3code/*|claude/*|claude-*|cursor/*|cursor-*|fox-inline-go)
    printf '\npre-push: rename tool-branded/random branch before pushing: %s\n\n' "$current_branch" >&2
    exit 1
    ;;
esac

# --verify --quiet resolves to an object or exits non-zero with no output. Do not use
# --symbolic-full-name here: with no upstream some git versions echo the literal '@{u}'
# and exit 0, which makes the origin/main fallback below unreachable.
upstream_commit=$(git rev-parse --verify --quiet '@{u}' 2>/dev/null || true)

if [ -n "$upstream_commit" ]; then
  base_commit=$(git merge-base HEAD "$upstream_commit")
elif git rev-parse --verify origin/main >/dev/null 2>&1; then
  base_commit=$(git merge-base HEAD origin/main)
else
  base_commit=$(git rev-list --max-parents=0 HEAD | tail -n 1)
fi

changed_files=$(git diff --name-only --diff-filter=ACMR "$base_commit"...HEAD)

if [ -z "$changed_files" ]; then
  exit 0
fi

has_changes() {
  printf '%s\n' "$changed_files" | grep -E "$1" >/dev/null
}

code_changed='^(apps/desktop|apps/sync-server|packages|scripts|package.json|pnpm-lock.yaml|pnpm-workspace.yaml|eslint.config.mjs|lint-staged.config.mjs|tsconfig|turbo.json)'

if ! has_changes "$code_changed"; then
  exit 0
fi
