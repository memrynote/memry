{
  "name": "memry-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "repair:links": "node scripts/repair-package-links.js .",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "pnpm --filter @memry/desktop dev",
    "dev:tauri": "pnpm --filter @memry/desktop-tauri tauri:dev",
    "dev:tauri:a": "pnpm --filter @memry/desktop-tauri tauri:dev:a",
    "dev:tauri:b": "pnpm --filter @memry/desktop-tauri tauri:dev:b",
    "dev:tauri:c": "pnpm --filter @memry/desktop-tauri tauri:dev:c",
    "build:tauri": "pnpm --filter @memry/desktop-tauri tauri:build",
    "dev:landing": "pnpm --filter @memry/landing dev",
    "dev:sync-server": "node scripts/run-turbo.js run dev --filter=@memry/sync-server",
    "dev:mobile": "bash scripts/dev-mobile.sh",
    "dev:mobile:device": "bash scripts/dev-mobile-device.sh",
    "dev:emails": "pnpm --filter @memry/marketing-emails dev",
    "staging": "MEMRY_ENV=staging pnpm --filter @memry/desktop dev:staging",
    "staging:tauri": "pnpm --filter @memry/desktop-tauri dev:staging",
    "staging:tauri:debug": "pnpm --filter @memry/desktop-tauri dev:staging:debug",
    "deploy:sync:staging": "pnpm --filter @memry/sync-server deploy:staging",
    "deploy:sync:production": "pnpm --filter @memry/sync-server deploy:production",
    "docs:dev": "pnpm --filter @memry/docs dev",
    "docs:build": "pnpm --filter @memry/docs build",
    "docs:preview": "pnpm --filter @memry/docs preview",
    "release": "node scripts/release.mjs",
    "cert:check": "cargo run --manifest-path crates/Cargo.toml -q -p memry-desktop --example cert_check --",
    "sandbox": "pnpm --filter @memry/cli sandbox",
    "seed": "pnpm --filter @memry/desktop seed:vault",
    "seed1k": "pnpm --filter @memry/desktop seed:bench",
    "seed:1": "pnpm --filter @memry/desktop seed:small --variant=1",
    "seed:2": "pnpm --filter @memry/desktop seed:small --variant=2",
    "release:humanize": "node scripts/humanize-release-notes.mjs",
    "release:reddit": "node scripts/build-reddit-release-post.mjs",
    "docs:impact": "node scripts/docs-impact.mjs",
    "docs:ai-update": "node scripts/docs-ai-update.mjs",
    "build": "pnpm build:desktop",
    "build:desktop": "pnpm --filter @memry/desktop build",
    "build:landing": "pnpm --filter @memry/landing build",
    "build:emails": "pnpm --filter @memry/marketing-emails build",
    "dev:extension": "pnpm --filter @memry/extension dev",
    "build:extension": "pnpm --filter @memry/extension build",
    "typecheck:extension": "pnpm --filter @memry/extension typecheck",
    "test:extension": "pnpm --filter @memry/extension test",
    "typecheck": "pnpm repair:links && node scripts/run-turbo.js run typecheck --filter=@memry/contracts --filter=@memry/db-schema --filter=@memry/domain-inbox --filter=@memry/domain-notes --filter=@memry/domain-tasks --filter=@memry/editor-schema --filter=@memry/storage-data --filter=@memry/storage-vault --filter=@memry/app-core --filter=@memry/rpc --filter=@memry/sync-core --filter=@memry/sync-client --filter=@memry/shared --filter=@memry/cli --filter=@memry/desktop --filter=@memry/desktop-tauri --filter=@memry/sync-server",
    "typecheck:packages": "pnpm repair:links && node scripts/run-turbo.js run typecheck --filter=@memry/contracts --filter=@memry/db-schema --filter=@memry/domain-inbox --filter=@memry/domain-notes --filter=@memry/domain-tasks --filter=@memry/editor-schema --filter=@memry/storage-data --filter=@memry/storage-vault --filter=@memry/app-core --filter=@memry/rpc --filter=@memry/sync-core --filter=@memry/shared --filter=@memry/cli",
    "typecheck:desktop": "pnpm --filter @memry/desktop typecheck",
    "typecheck:landing": "pnpm --filter @memry/landing typecheck",
    "typecheck:sync-server": "pnpm --filter @memry/sync-server typecheck",
    "typecheck:emails": "pnpm --filter @memry/marketing-emails typecheck",
    "test": "pnpm repair:links && node scripts/run-turbo.js run test --filter=@memry/contracts --filter=@memry/sync-client --filter=@memry/app-core --filter=@memry/cli --filter=@memry/desktop --filter=@memry/editor-schema --filter=@memry/sync-server --filter=@memry/landing",
    "test:cli": "pnpm --filter @memry/app-core test && pnpm --filter @memry/cli test",
    "test:release": "node --test scripts/rehearsal/rehearsal.test.mjs scripts/release/vpk-args.test.mjs scripts/release/bridge-feeds.test.mjs scripts/release/stage-payload.test.mjs scripts/release/webview2-bootstrapper.test.mjs scripts/release/pe-imports.test.mjs scripts/release/is-main.test.mjs scripts/validate-mac-update-manifest.test.mjs scripts/release-utils.test.mjs scripts/release-notes-utils.test.mjs scripts/reddit-release-utils.test.mjs scripts/pre-push-policy.test.mjs scripts/lint-ratchet.test.mjs tools/oxlint/memry/no-window-fanout.test.mjs tools/oxlint/memry/no-location-navigation.test.mjs tools/oxlint/memry/no-window-open.test.mjs scripts/docs-impact.test.mjs scripts/package-scripts.test.mjs scripts/link-env.test.mjs scripts/check-staged-renderer-guards.test.mjs scripts/launch-bench.test.mjs apps/desktop/scripts/build-packaged-app-utils.test.cjs apps/desktop/scripts/check-native.test.cjs apps/desktop/scripts/check-packaged-runtime-deps-utils.test.cjs apps/desktop/scripts/prune-packaged-app.test.mjs",
    "test:desktop": "pnpm --filter @memry/desktop test",
    "test:sync-server": "pnpm --filter @memry/sync-server test",
    "test:sync-harness": "pnpm --filter @memry/sync-harness build:worker && pnpm --filter @memry/sync-harness test",
    "test:coverage": "pnpm --filter @memry/desktop test:coverage",
    "test:e2e": "pnpm --filter @memry/desktop test:e2e",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:fix": "oxlint --fix",
    "i18n:check": "pnpm --filter @memry/desktop i18n:check",
    "i18n:codemod:todo": "pnpm --filter @memry/desktop i18n:codemod:todo",
    "i18n:codemod:todo:check": "pnpm --filter @memry/desktop i18n:codemod:todo:check",
    "i18n:codemod:todo:dry-run": "pnpm --filter @memry/desktop i18n:codemod:todo:dry-run",
    "test:i18n-tools": "pnpm --filter @memry/desktop test:i18n-tools",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:contracts": "node scripts/check-contract-boundaries.js",
    "check:architecture": "node scripts/check-architecture-boundaries.js",
    "check:native": "node apps/desktop/scripts/check-native.js",
    "check:staged-secrets": "node scripts/check-staged-secrets.mjs",
    "check:staged-renderer-guards": "node scripts/check-staged-renderer-guards.mjs",
    "ipc:generate": "pnpm --filter @memry/desktop ipc:generate && pnpm --filter @memry/desktop-tauri ipc:generate",
    "ipc:check": "pnpm --filter @memry/desktop ipc:check && pnpm --filter @memry/desktop-tauri ipc:check",
    "sync:clean": "rm -rf apps/sync-server/.wrangler",
    "sync:init-db": "pnpm --filter @memry/sync-server exec wrangler d1 migrations apply memry-sync --local",
    "sync:reset": "pnpm sync:clean && pnpm sync:init-db",
    "sync:reset:staging": "pnpm --filter @memry/sync-server reset:staging",
    "staging:user": "pnpm --filter @memry/sync-server staging:user",
    "check:lockfile": "node scripts/check-lockfile.js",
    "check:renderer-sync-host": "node scripts/check-renderer-no-sync-host.mjs",
    "check:test-timing": "node scripts/check-test-timing.mjs",
    "warm": "node scripts/warm-native.mjs --target electron",
    "warm:bg": "node scripts/warm-native.mjs --background --target electron",
    "warm:log": "node scripts/warm-native.mjs --log",
    "env:link": "node scripts/link-env.mjs",
    "env:link:copy": "node scripts/link-env.mjs --copy",
    "env:check": "node scripts/link-env.mjs --check",
    "prepare": "husky || true && node scripts/link-env.mjs || true",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "app-builder-lib": "26.15.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-doctor": "^0.9.0",
    "turbo": "^2.9.16",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@~6.0.3"
  }
}
