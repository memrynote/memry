{
  "mcpServers": {
    "paddle-sandbox": {
      "url": "https://sandbox-mcp.paddle.com/mcp",
      "headers": { "Authorization": "Bearer ${PADDLE_SANDBOX_API_KEY}" }
    },
    "paper": {
      "command": "~/.paper/bin/paper",
      "args": ["mcp"]
    },
    "playwright-memry": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222",
        "--output-dir",
        "/tmp/memry-playwright-mcp"
      ]
    },
    "webdriver-memry": {
      "command": "node",
      "args": ["apps/desktop-tauri/scripts/webdriver-mcp.mjs"],
      "env": {
        "MEMRY_WEBDRIVER_URL": "http://127.0.0.1:9222",
        "MEMRY_AGENT_SCREENSHOT_DIR": "/tmp/memry-webdriver-mcp"
      }
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
