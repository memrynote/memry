{
  "name": "@memry/desktop",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "memrynote desktop app",
  "main": "./out/main/index.js",
  "engines": {
    "node": "24.x"
  },
  "author": "memrynote",
  "homepage": "https://github.com/memrynote/memry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memrynote/memry.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "repair:links": "node ../../scripts/repair-package-links.js apps/desktop",
    "prelint": "pnpm repair:links",
    "lint": "pnpm exec eslint --cache .",
    "i18n:check": "node scripts/i18n/check.mjs --max-todo 0",
    "i18n:codemod:todo": "node scripts/i18n/codemod-todo-jsx-literals.mjs --write",
    "i18n:codemod:todo:check": "node scripts/i18n/codemod-todo-jsx-literals.mjs --check",
    "i18n:codemod:todo:dry-run": "node scripts/i18n/codemod-todo-jsx-literals.mjs --dry-run",
    "test:i18n-tools": "node --test scripts/i18n/*.test.mjs scripts/i18n/eslint/*.test.mjs",
    "pretypecheck": "pnpm repair:links && pnpm --dir ../.. check:contracts && pnpm --dir ../.. check:architecture && pnpm ipc:check",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "pnpm exec tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test:node": "pnpm exec tsc --noEmit -p tsconfig.test.node.json --composite false",
    "typecheck:test:web": "pnpm exec tsc --noEmit -p tsconfig.test.web.json --composite false",
    "typecheck:test": "pnpm typecheck:test:node && pnpm typecheck:test:web",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "start": "electron-vite preview",
    "dev": "MEMRY_ENV=development MEMRY_DEVICE=dev MEMRY_FORCE_VAULT_PICKER=1 electron-vite dev --mode=dev",
    "dev:staging": "MEMRY_ENV=staging MEMRY_DEVICE=dev electron-vite dev --mode=staging",
    "dev:protocol": "node scripts/patch-dev-protocol.mjs",
    "dev:a": "bash scripts/ensure-native.sh electron && MEMRY_ENV=development MEMRY_DEVICE=A MEMRY_FORCE_VAULT_PICKER=1 electron-vite dev --mode=dev",
    "dev:b": "bash scripts/ensure-native.sh electron && MEMRY_ENV=development MEMRY_DEVICE=B MEMRY_FORCE_VAULT_PICKER=1 electron-vite dev --mode=dev",
    "dev:c": "bash scripts/ensure-native.sh electron && MEMRY_ENV=development MEMRY_DEVICE=C MEMRY_FORCE_VAULT_PICKER=1 electron-vite dev --mode=dev",
    "dev:a:staging": "bash scripts/ensure-native.sh electron && MEMRY_ENV=staging MEMRY_DEVICE=A electron-vite dev --mode=staging",
    "dev:b:staging": "bash scripts/ensure-native.sh electron && MEMRY_ENV=staging MEMRY_DEVICE=B electron-vite dev --mode=staging",
    "dev:c:staging": "bash scripts/ensure-native.sh electron && MEMRY_ENV=staging MEMRY_DEVICE=C electron-vite dev --mode=staging",
    "clean:a": "rm -rf \"$HOME/Library/Application Support/memry-A\"",
    "clean:b": "rm -rf \"$HOME/Library/Application Support/memry-B\"",
    "clean:c": "rm -rf \"$HOME/Library/Application Support/memry-C\"",
    "clean:devices": "pnpm clean:a && pnpm clean:b && pnpm clean:c",
    "build": "cross-env MEMRY_ENV=production pnpm typecheck && cross-env MEMRY_ENV=production electron-vite build && node scripts/check-worker-bundles.mjs",
    "build:release": "pnpm repair:links && bash scripts/check-cert-hashes.sh && cross-env MEMRY_ENV=production electron-vite build && node scripts/check-worker-bundles.mjs",
    "postinstall": "[ \"$SKIP_ELECTRON_REBUILD\" = '1' ] || pnpm exec electron-rebuild -o better-sqlite3,classic-level,keytar",
    "rebuild:node": "bash scripts/ensure-native.sh node",
    "rebuild:electron": "bash scripts/ensure-native.sh electron",
    "rebuild:node:force": "pnpm rebuild better-sqlite3",
    "rebuild:electron:force": "pnpm exec electron-rebuild -f -o better-sqlite3",
    "pretest": "pnpm repair:links && bash scripts/ensure-native.sh node",
    "pretest:watch": "pnpm repair:links && bash scripts/ensure-native.sh node",
    "pretest:ui": "pnpm repair:links && bash scripts/ensure-native.sh node",
    "pretest:coverage": "pnpm repair:links && bash scripts/ensure-native.sh node",
    "predev": "pnpm repair:links && bash scripts/ensure-native.sh electron",
    "prebuild": "pnpm repair:links && bash scripts/check-cert-hashes.sh && bash scripts/ensure-native.sh electron",
    "cert:check": "bash scripts/check-cert-hashes.sh",
    "cert:extract": "npx tsx scripts/extract-cert-hashes.ts",
    "db:generate": "drizzle-kit generate --config config/drizzle-data.config.ts && drizzle-kit generate --config config/drizzle-index.config.ts",
    "db:generate:data": "drizzle-kit generate --config config/drizzle-data.config.ts",
    "db:generate:index": "drizzle-kit generate --config config/drizzle-index.config.ts",
    "db:push": "drizzle-kit push --config config/drizzle-data.config.ts && drizzle-kit push --config config/drizzle-index.config.ts",
    "db:push:data": "drizzle-kit push --config config/drizzle-data.config.ts",
    "db:push:index": "drizzle-kit push --config config/drizzle-index.config.ts",
    "db:studio:data": "drizzle-kit studio --config config/drizzle-data.config.ts",
    "db:studio:index": "drizzle-kit studio --config config/drizzle-index.config.ts",
    "db:benchmark": "node --expose-gc --import tsx scripts/sqlite-memory-benchmark.ts",
    "build:unpack": "pnpm build && node scripts/build-packaged-app.js --dir",
    "build:win": "pnpm build && electron-builder --config config/electron-builder.yml --win",
    "build:mac": "pnpm build && node scripts/build-packaged-app.js --mac",
    "build:mac:signed:local": "node scripts/build-mac-signed-local.mjs",
    "build:linux": "pnpm build && electron-builder --config config/electron-builder.yml --linux",
    "check:packaged-runtime": "node scripts/check-packaged-runtime-deps.js",
    "test": "pnpm exec vitest run --config config/vitest.config.ts",
    "test:watch": "pnpm exec vitest watch --config config/vitest.config.ts",
    "test:ui": "pnpm exec vitest --ui --config config/vitest.config.ts",
    "test:coverage": "pnpm exec vitest run --coverage --config config/vitest.config.ts",
    "test:shared": "pnpm exec vitest run --config config/vitest.config.ts --project shared",
    "test:main": "pnpm exec vitest run --config config/vitest.config.ts --project main",
    "test:main-integration": "pnpm exec vitest run --config config/vitest.config.ts --project main-integration",
    "test:renderer": "pnpm exec vitest run --config config/vitest.config.ts --project renderer",
    "test:unit": "pnpm exec vitest run --config config/vitest.config.ts tests/unit",
    "test:integration": "pnpm exec vitest run --config config/vitest.config.ts tests/integration",
    "test:component": "pnpm exec vitest run --config config/vitest.config.ts tests/component",
    "pretest:e2e": "pnpm repair:links && bash scripts/ensure-native.sh electron",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:keychain-tools": "node --test scripts/purge-e2e-keychain.test.mjs",
    "keychain:purge-e2e": "node scripts/purge-e2e-keychain.mjs",
    "rpc:generate": "node --experimental-strip-types --experimental-transform-types scripts/generate-rpc-bindings.ts",
    "rpc:check": "node --experimental-strip-types --experimental-transform-types scripts/generate-rpc-bindings.ts --check",
    "ipc:generate": "pnpm rpc:generate && node scripts/generate-ipc-invoke-map.js",
    "ipc:check": "pnpm rpc:check && node scripts/generate-ipc-invoke-map.js --check",
    "generate:icons": "node scripts/generate-icons.mjs",
    "seed:vault": "bash scripts/ensure-native.sh node && npx tsx scripts/seed-vault.ts",
    "seed:rich": "bash scripts/ensure-native.sh node && npx tsx scripts/seed-rich-vault.ts"
  },
