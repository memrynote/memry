# Store PEM values on a single line with literal \n escapes.
JWT_PUBLIC_KEY=replace-me
JWT_PRIVATE_KEY=replace-me
RESEND_API_KEY=replace-me
# Recipient address for in-app feedback submissions (POST /feedback).
FEEDBACK_RECIPIENT=replace-me
GOOGLE_CLIENT_ID=replace-with-real-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=replace-with-registered-google-redirect-uri
OTP_HMAC_KEY=replace-me
RECOVERY_DUMMY_SECRET=replace-me
WEBHOOK_HMAC_KEY=replace-me
PADDLE_WEBHOOK_SECRET=replace-me
PADDLE_CHECKOUT_TOKEN_SECRET=replace-me
TELEMETRY_HMAC_KEY=replace-me
# Optional PostHog mirroring:
# POSTHOG_KEY=replace-with-posthog-project-token
# Optional: raises the GitHub Releases API rate limit for the daily download-count cron.
# GITHUB_TOKEN=replace-with-a-public-repo-read-token
# Optional: comma-separated emails auto-granted a paid (believer) sync plan in development.
# LOCAL_ADMIN_SYNC_EMAILS=admin@example.com
