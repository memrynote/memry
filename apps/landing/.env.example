# Resend — https://resend.com/api-keys
RESEND_API_KEY=replace-me-with-resend-api-key

# Required: Resend Segment ID the newsletter signup (/api/subscribe) files contacts into
# Create at https://resend.com/segments -> copy the ID
RESEND_SEGMENT_ID=replace-me-with-newsletter-segment-id

# Resend webhook signing secret for /api/resend-webhook
RESEND_WEBHOOK_SECRET=

# Sync server base URL (no trailing slash). Dev default: http://localhost:8787
VITE_SYNC_SERVER_URL=http://localhost:8787

# PostHog project API key. Analytics/session replay no-op silently without it.
VITE_POSTHOG_KEY=replace-me-with-posthog-project-key
# PostHog ingest host (reverse-proxied). Defaults to https://e.memrynote.com if unset.
VITE_POSTHOG_HOST=https://e.memrynote.com

# Paddle Billing sandbox checkout
# Server-side secret. In production, set PADDLE_ENVIRONMENT=production and use the live key.
PADDLE_ENVIRONMENT=sandbox
PADDLE_SANDBOX_API_KEY=replace-me-with-paddle-sandbox-api-key
# PADDLE_API_KEY=replace-me-with-paddle-live-api-key
PADDLE_CHECKOUT_TOKEN_SECRET=replace-me

# Safe public token from Paddle > Developer tools; required for overlay checkout.
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=replace-me-with-paddle-client-side-token

# Paddle price IDs from Catalog > Products > Prices.
PADDLE_PRICE_PLUS_MONTHLY=pri_01krjx0crys52an7btk9wd7xab
PADDLE_PRICE_PLUS_ANNUAL=pri_01krjx177kga0abmpwz49xxk7e
PADDLE_PRICE_PRO_MONTHLY=pri_01krjx5k8qdj9cq0zh5grw7047
PADDLE_PRICE_PRO_ANNUAL=pri_01krjx6e8wf2b8jmg0q97f29mc
PADDLE_PRICE_BELIEVER_LIFETIME=pri_01krjx81g08bgqtehqxkrbjeee

# Optional only when Paddle Checkout already has a Default Payment Link.
# For sandbox localhost testing without a dashboard default, set http://localhost:5173/pricing.
PADDLE_CHECKOUT_URL=
