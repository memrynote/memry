{
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/generated/**/*",
    "../../packages/contracts/src/**/*",
    "../../packages/domain-inbox/src/**/*",
    "../../packages/domain-tasks/src/**/*",
    "../../packages/domain-notes/src/journal/**/*",
    "../../packages/db-schema/src/**/*",
    "../../packages/storage-data/src/**/*",
    "../../packages/rpc/src/**/*",
    "../../packages/shared/src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts"
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@memry/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@memry/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@memry/domain-inbox": [
        "../../packages/domain-inbox/src/index.ts"
      ],
      "@memry/domain-inbox/*": [
        "../../packages/domain-inbox/src/*"
      ],
      "@memry/domain-tasks": [
        "../../packages/domain-tasks/src/index.ts"
      ],
      "@memry/domain-tasks/*": [
        "../../packages/domain-tasks/src/*"
      ],
      "@memry/domain-notes/journal": [
        "../../packages/domain-notes/src/journal/index.ts"
      ],
      "@memry/db-schema": [
        "../../packages/db-schema/src/index.ts"
      ],
      "@memry/db-schema/*": [
        "../../packages/db-schema/src/*"
      ],
      "@memry/storage-data": [
        "../../packages/storage-data/src/index.ts"
      ],
      "@memry/storage-data/*": [
        "../../packages/storage-data/src/*"
      ],
      "@memry/rpc": [
        "../../packages/rpc/src/index.ts"
      ],
      "@memry/rpc/*": [
        "../../packages/rpc/src/*"
      ],
      "@memry/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@memry/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@tests/*": [
        "./tests/*"
      ],
      "@memry/storage-vault": [
        "../../packages/storage-vault/src/index.ts"
      ],
      "@memry/storage-vault/*": [
        "../../packages/storage-vault/src/*"
      ]
    }
  }
}
