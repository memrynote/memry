{
  "name": "@memry/desktop-tauri",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "MemryNote desktop app on Tauri v2",
  "scripts": {
    "dev:renderer": "cross-env VITE_MEMRY_DEV_API_PROXY=1 vite",
    "build:renderer": "cross-env VITE_MEMRY_DEV_API_PROXY=1 vite build",
    "build:renderer:e2e": "cross-env VITE_MEMRY_E2E=1 VITE_MEMRY_DEV_API_PROXY=1 vite build",
    "tauri": "tauri",
    "tauri:dev": "cross-env VITE_MEMRY_DEV_API_PROXY=1 MEMRY_ENV=development MEMRY_DEVICE=dev tauri dev",
    "tauri:dev:a": "cross-env VITE_MEMRY_DEV_API_PROXY=1 MEMRY_ENV=development MEMRY_DEVICE=A tauri dev",
    "tauri:dev:b": "cross-env VITE_MEMRY_DEV_API_PROXY=1 MEMRY_ENV=development MEMRY_DEVICE=B tauri dev",
    "tauri:dev:c": "cross-env VITE_MEMRY_DEV_API_PROXY=1 MEMRY_ENV=development MEMRY_DEVICE=C tauri dev",
    "tauri:build": "cross-env VITE_MEMRY_DEV_API_PROXY=1 tauri build --debug --no-bundle",
    "build:e2e": "cross-env VITE_MEMRY_DEV_API_PROXY=1 VITE_MEMRY_E2E=1 tauri build --debug --no-bundle --features e2e",
    "ipc:generate": "cargo run --manifest-path ../../crates/Cargo.toml -p memry-tauri --bin export-bindings -- --out src/generated/bindings.ts",
    "ipc:check": "cargo run --manifest-path ../../crates/Cargo.toml -p memry-tauri --bin export-bindings -- --check src/generated/bindings.ts",
    "pretypecheck": "pnpm ipc:check",
    "typecheck": "node ../../scripts/typecheck.mjs tsconfig.web.json tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
