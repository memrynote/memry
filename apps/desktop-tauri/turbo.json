{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/sync-client/**",
        "$TURBO_ROOT$/packages/sync-core/**",
        "$TURBO_ROOT$/crates/**",
        "!$TURBO_ROOT$/crates/target/**",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
