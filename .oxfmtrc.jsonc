{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  // Prettier never sorted package.json keys; keep key order author-controlled.
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "out",
    "dist",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    // Profiles captured from real Electron installs, read by byte (electron_import tests).
    "crates/memry-desktop/tests/fixtures/electron/**",

    // Grammar corpus notes of the markdown converter: their bytes are the test input.
    "packages/contracts/test-vectors/markdown-convert/corpus/**",

    // Golden files for the i18n codemod tests, compared byte for byte.
    "apps/desktop/scripts/i18n/fixtures/**",
    "package-lock.json",
    "yarn.lock",
    "LICENSE.md",
    "tsconfig.json",
    "tsconfig.*.json",
    ".env*",

    // Written by `pnpm lint --update` one file per line; a formatter would expand it to ~25k lines.
    "scripts/lint-baseline.json",

    // Prettier never formatted TOML; keep Cargo.toml and wrangler.toml as authored.
    "**/*.toml",

    // Xcode owns the asset catalog JSON layout.
    "**/*.xcassets/**",

    // Tool caches and ElevenLabs voice-over caches: machine-written, one-line JSON.
    "**/.impeccable/",
    "marketing/tutorials/demo/vo/*.json",

    // Generated by codegen scripts (rpc:check / ipc:check do exact-string compares;
    // formatted output won't match the generator's raw output).
    "apps/desktop/src/main/ipc/generated-ipc-invoke-map.ts",
    "apps/desktop-tauri/src/generated/**",
    "apps/desktop/src/preload/generated-rpc.ts",

    // Golden byte-preservation fixtures: bytes (CRLF, BOM, missing final newline)
    // ARE the test contract — formatting them destroys what they assert.
    "apps/desktop/src/main/vault/__fixtures__/golden-vault/",

    // Generated conformance vectors: `vectors:check` regenerates them and does an
    // exact-string compare, so a formatter that reflows an array turns a clean tree
    // into a permanently red gate. The bytes are the contract, not the layout.
    "packages/contracts/test-vectors/*.json",
    "packages/contracts/test-vectors/markdown-roundtrip/*.json",
    "packages/contracts/test-vectors/markdown-convert/*.json",
    "packages/contracts/test-vectors/article-extract/",
    "crates/memry-desktop/src/web/extract/elements/math/mathml/tables.json",
    "crates/memry-desktop/src/web/extract/elements/math/temml/tables.json",

    // Saved pages of the article-extraction corpus, parsed byte for byte by the Rust tests.
    "crates/memry-desktop/tests/fixtures/article-extract/",

    // Generated minified bundle (scripts/generate-ios-article-extract.mjs); a formatter
    // reflows 1.2 MB of minified JS into 27k lines with trailing whitespace.
    "apps/ios/Memry/Resources/article-extract.js",

    // Vendored KaTeX and mermaid, copied as-is by apps/ios/scripts/generate-block-render.mjs.
    "apps/ios/Memry/Resources/BlockRender.bundle/vendor/",

    // Excalidraw bundled by apps/ios/scripts/generate-whiteboard.mjs; a formatter would
    // reflow 8 MB of minified JS into 240k lines.
    "apps/ios/Memry/Resources/Whiteboard.bundle/"
  ]
}
